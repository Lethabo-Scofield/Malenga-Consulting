# Copy to .env.local for development and set these in Vercel for production.
# Never commit real values.

# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.malengaconsulting.co.za

# WhatsApp number, international format, digits only (no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=27824458568

# Where enquiries are delivered (comma-separate for several recipients)
CONTACT_TO_EMAIL=
# Sender address. With Resend this must be on a verified domain.
CONTACT_FROM_EMAIL=

# Option A: Resend (used when RESEND_API_KEY is set)
RESEND_API_KEY=

# Option B: SMTP (used when RESEND_API_KEY is empty and SMTP_HOST is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
